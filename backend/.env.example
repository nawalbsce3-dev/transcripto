# Transcripto Backend Configuration

# Flask Configuration
FLASK_APP=app.py
FLASK_DEBUG=True
PORT=5000

# Whisper Model Configuration
# Options: tiny, base, small, medium, large
# tiny: fastest, least accurate
# base: good balance
# small: better accuracy (recommended) ⭐
# medium/large: best accuracy, much slower
WHISPER_MODEL=small
